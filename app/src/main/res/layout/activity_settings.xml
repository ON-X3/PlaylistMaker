<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/basic_padding" >


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/back_from_settings"
            style="@style/BackButton"
            />

        <TextView
            style="@style/TitleStyle"
            android:text="@string/settings" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:paddingEnd="6dp">

        <TextView
            style="@style/SettingsListStyle"
            android:text="@string/theme" />

        <Switch
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:layout_gravity="end|center_vertical" />

    </FrameLayout>

    <FrameLayout
        android:id="@+id/share_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingEnd="@dimen/settings_right_padding">

        <TextView
            style="@style/SettingsListStyle"
            android:text="@string/share" />

        <ImageView
            style="@style/SettingsIconStyle"
            android:src="@drawable/ic_share_24" />

    </FrameLayout>

    <FrameLayout
        android:id="@+id/support_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingEnd="@dimen/settings_right_padding">

        <TextView
            style="@style/SettingsListStyle"
            android:text="@string/support" />

        <ImageView
            style="@style/SettingsIconStyle"
            android:src="@drawable/ic_support_24" />

    </FrameLayout>

    <FrameLayout
        android:id="@+id/agreement_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingEnd="@dimen/settings_right_padding">

        <TextView
            style="@style/SettingsListStyle"
            android:text="@string/agreement" />

        <ImageView
            style="@style/SettingsIconStyle"
            android:src="@drawable/ic_arrow_forward_24" />

    </FrameLayout>


</LinearLayout>