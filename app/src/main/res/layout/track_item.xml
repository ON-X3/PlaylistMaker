<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/trackRootLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="13dp"
    android:paddingEnd="@dimen/settings_right_padding"
    android:paddingVertical="@dimen/small_padding">

    <ImageView
        android:id="@+id/artwork"
        android:layout_width="45dp"
        android:layout_height="45dp"
        tools:src="@drawable/placeholder_45"
        app:tint="@color/yp_text_gray"
        />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/small_padding"
        android:layout_gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/trackName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:scrollHorizontally="true"
            tools:text="Yesterday fdgfgfgerg ergergerge rgergregre wp"
            android:textAppearance="@style/SettingsListStyle"
            />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="1dp">

            <TextView
                style="@style/InfoTextStyle"
                android:id="@+id/artistName"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                tools:text="The Beatles gfjkkjfdfg dfgdfgdfgd fgdffgdfgsdfgg"
                android:maxLines="1"
                android:ellipsize="end"
                android:scrollHorizontally="true"/>

            <TextView
                style="@style/InfoTextStyle"
                android:id="@+id/trackTime"
                android:maxLines="1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:drawableStartCompat="@drawable/ic_dot_13"
                tools:text="2:55"/>

        </LinearLayout>

    </LinearLayout>

    <ImageView
        android:layout_width="@dimen/ic_size"
        android:layout_height="@dimen/ic_size"
        android:layout_gravity="center_vertical"
        android:src="@drawable/ic_arrow_forward_24"
        style="@style/InfoTextStyle"/>
</LinearLayout>