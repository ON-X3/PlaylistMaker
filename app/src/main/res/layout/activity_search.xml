<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SearchActivity"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/basic_padding"

    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/basic_padding">

        <ImageView
            android:id="@+id/back_from_search"
            style="@style/BackButton"
            />

        <TextView
            style="@style/TitleStyle"
            android:text="@string/search"/>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp"
        >

        <EditText
            android:id="@+id/searchEditText"
            style="@style/SearchBoxStyle"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/search_box_backgroud"
            android:layout_gravity="start"
            android:hint="@string/search"
            android:paddingStart="36dp"
            android:paddingEnd="40dp"
            android:fontFamily="@font/ys_display_regular"
            android:textColor="@color/yp_black"
            android:lines="1"
            android:inputType="text"

            />

        <ImageView
            style="@style/SearchBoxIconStyle"
            android:layout_width="18dp"
            android:layout_height="16dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="12dp"
            android:src="@drawable/ic_search_16"
            android:background="@android:color/transparent"
            />

        <ImageView
            style="@style/SearchBoxIconStyle"
            android:id="@+id/clear_button"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:src="@drawable/ic_clear_16"
            android:paddingHorizontal="12dp"
            android:background="@android:color/transparent"
            android:visibility="gone"
            />
        
    </FrameLayout>
    


</LinearLayout>