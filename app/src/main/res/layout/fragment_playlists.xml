<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/newPlaylistButton"
        style="@style/SearchActivityButton"
        android:text="@string/new_playlist" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/playlistsList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="@dimen/basic_padding"
        android:visibility="visible"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="2"
        tools:itemCount="3"
        tools:listitem="@layout/playlist_item" />

    <LinearLayout
        android:id="@+id/playlistsPlaceholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="46dp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/playlistsPlaceholderImage"
            style="@style/PlaceholderImageStyle"
            android:src="@drawable/search_nothing"
            android:contentDescription="@null"/>

        <TextView
            android:id="@+id/playlistsPlaceholderText"
            style="@style/PlaceholderTextStyle"
            android:text="@string/no_playlists" />
    </LinearLayout>

</LinearLayout>