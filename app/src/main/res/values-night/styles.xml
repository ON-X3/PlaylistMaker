<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MainActivityStyle">
        <item name="android:background">@color/yp_black</item>
    </style>

    <style name="SettingsListStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">@dimen/settings_list_height</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textSize">@dimen/settings_text_size</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="drawableTint">?attr/colorOnPrimary</item>
        <item name="android:paddingStart">@dimen/basic_padding</item>
        <item name="android:paddingEnd">@dimen/settings_right_padding</item>
    </style>

    <style name="MainToolbarStyle" parent="ToolbarStyle">
        <item name="android:background">@color/yp_black</item>
        <item name="titleTextColor">@color/white</item>
    </style>

    <style name="SearchBoxStyle">
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:textColorHint">@color/yp_black</item>
        <item name="android:drawableTint">@color/yp_black</item>
    </style>

    <style name="SearchBoxIconStyle">
        <item name="tint">@color/yp_black</item>
    </style>

    <style name="InfoTextStyle">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">@dimen/info_text_size</item>
        <item name="android:textColor">@color/white</item>
        <item name="tint">@color/white</item>
        <item name="drawableTint">@color/white</item>
    </style>

</resources>