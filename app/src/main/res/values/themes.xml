<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.PlaylistMaker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/white</item>
        <item name="colorSecondary">@color/blue</item>
        <item name="colorOnPrimary">@color/yp_black</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <style name="MainActivity.Theme" parent="Base.Theme.PlaylistMaker">
        <item name="colorPrimary">@color/blue</item>
    </style>

    <style name="ThemeOverlay.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/yp_black</item>
        <item name="colorPrimary">@color/yp_blue</item>
    </style>
</resources>