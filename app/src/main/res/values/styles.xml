<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="MainActivityStyle">
        <item name="android:background">@color/blue</item>
    </style>

    <style name="MainButtonStyle" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_marginTop">@dimen/button_margin</item>
        <item name="android:layout_weight">1</item>
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/yp_black</item>
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/main_ic_padding</item>
        <item name="iconTint">@color/yp_black</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">@dimen/basic_text_size</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:layout_marginHorizontal">@dimen/basic_padding</item>
    </style>

    <style name="SettingsListStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">@dimen/settings_list_height</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/settings_text_size</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="drawableTint">@color/yp_text_gray</item>
        <item name="android:paddingStart">@dimen/basic_padding</item>
        <item name="android:paddingEnd">@dimen/settings_right_padding</item>
    </style>

    <style name="TitleStyle">
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">@dimen/basic_text_size</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="ToolbarStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/toolabr_height</item>
        <item name="contentInsetStart">@dimen/basic_padding</item>
        <item name="contentInsetStartWithNavigation">64dp</item>
        <item name="titleTextAppearance">@style/TitleStyle</item>
    </style>

    <style name="MainToolbarStyle" parent="ToolbarStyle">
        <item name="android:background">@color/blue</item>
        <item name="titleTextColor">@color/white</item>
    </style>

    <style name="BackButton">
        <item name="android:layout_width">@dimen/ic_size</item>
        <item name="android:layout_height">@dimen/ic_size</item>
        <item name="android:layout_marginTop">@dimen/basic_padding</item>
        <item name="tint">?attr/colorOnPrimary</item>
        <item name="android:src">@drawable/ic_arrow_back_24</item>
    </style>

    <style name="SearchBoxStyle">
        <item name="android:backgroundTint">@color/yp_light_gray</item>
        <item name="android:textColorHint">@color/yp_text_gray</item>
        <item name="android:drawableTint">@color/yp_text_gray</item>
    </style>

    <style name="SearchBoxIconStyle">
        <item name="tint">@color/yp_text_gray</item>
    </style>
    
    <style name="InfoTextStyle">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">@dimen/info_text_size</item>
        <item name="android:textColor">@color/yp_text_gray</item>
        <item name="tint">@color/yp_text_gray</item>
        <item name="drawableTint">@color/yp_text_gray</item>
    </style>

    <style name="SearchActivityButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@null</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:backgroundTint">?attr/colorOnPrimary</item>
        <item name="cornerRadius">54dp</item>
    </style>

    <style name="SearchActivityTextStyle" parent="TitleStyle">
        <item name="android:textSize">19sp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="ListOfTrackAttrStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginHorizontal">@dimen/basic_padding</item>
        <item name="android:gravity">center_vertical</item>

    </style>

    <style name="ListOfTrackAttrNameStyle" parent="ListOfTrackAttrStyle">
        <item name="layout_constraintStart_toStartOf">parent</item>
        <item name="android:textColor">@color/yp_text_gray</item>
    </style>

    <style name="ListOfTrackAttrValueStyle" parent="ListOfTrackAttrStyle">
        <item name="layout_constraintEnd_toEndOf">parent</item>
        <item name="layout_constraintStart_toEndOf">@id/list_of_track_attr_barrier</item>
        <item name="layout_constraintHorizontal_bias">1</item>
        <item name="layout_constrainedWidth">true</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:scrollHorizontally">true</item>
    </style>

    <style name="PlaceholderImageStyle">
        <item name="android:layout_width">120dp</item>
        <item name="android:layout_height">120dp</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="tint">@null</item>
    </style>

    <style name="PlaceholderTextStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">24dp</item>
        <item name="android:layout_marginTop">@dimen/basic_padding</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:textAppearance">@style/SearchActivityTextStyle</item>
    </style>

    <style name="LibraryTabStyle">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

</resources>